    "mongodb": "^6.20.0",
    "nanoid": "^5.1.6",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "nodemon": "^3.1.10",
    "npm": "^11.6.2",
    "react": "19.1.4",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.1.4",
