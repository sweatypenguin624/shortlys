generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Url {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  url      String
  shorturl String  @unique
  userId   String
  visits   Visit[]
  qrCode   QrCode?
}

model Visit {
  id        String   @id @default(cuid()) @map("_id")
  urlId     String
  device    String
  location  String
  browser   String
  os        String
  referrer  String?
  source    String?
  createdAt DateTime @default(now())

  url Url @relation(fields: [urlId], references: [id])
}

model QrCode {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  urlId            String   @unique @db.ObjectId
  userId           String
  label            String?
  fgColor          String   @default("#111827")
  bgColor          String   @default("#FFFFFF")
  level            String   @default("M")
  size             Int      @default(1024)
  createdShortLink Boolean  @default(true)
  scanCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  url              Url      @relation(fields: [urlId], references: [id])

  @@index([userId, createdAt])
}

model RateLimit {
  id          String   @id @default(cuid()) @map("_id")
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}
